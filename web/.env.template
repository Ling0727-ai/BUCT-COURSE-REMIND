# ──────────────────────────────────────────────────────────────
# 环境变量模板
#
# 使用方式：
#   cp .env.template .env
#   然后按下方说明填入真实值
#
# ⚠️ 不要把填好的 .env 提交到仓库。.env 已在 .gitignore 中忽略。
#
# ⚠️ 本项目的 Docker 镜像里不含任何密钥或默认凭据，
#    下面这些值全部由你在运行时通过 .env 注入。
#    标「必填」的变量若留空，docker compose 会直接报错退出。
# ──────────────────────────────────────────────────────────────

# ── MongoDB（必填）───────────────────────────────────────────
MONGO_PORT=27017
MONGO_INITDB_ROOT_USERNAME=your_mongo_username
MONGO_INITDB_ROOT_PASSWORD=your_mongo_password
MONGO_INITDB_DATABASE=buct-course

# ── 后端应用 ─────────────────────────────────────────────────
GO_PORT=5000
# JWT 签名密钥（必填，无默认值）
# 必须是随机长字符串，例如：openssl rand -hex 32
# 不要使用任何示例值——该值用于签发登录态，泄漏即可伪造任意用户身份。
SECRET_KEY=

# ── 邮件（必填，否则验证码与提醒邮件不可用）────────────────────
MAIL_SMTP_SERVER=smtp.163.com
MAIL_SMTP_PORT=465
MAIL_SENDER=your_email@163.com
# 注意是邮箱「授权码」，不是登录密码
MAIL_PASSWORD=your_email_auth_code
VERIFY_CODE_EXPIRE=180

# ── ECC 密钥（必填）──────────────────────────────────────────
# 用于加密存储学生的学校密码。生成方式见 README「ECC 密钥生成」。
#
# ⚠️ 更换密钥会导致库中已加密的 s_password 无法解密，
#    必须同步执行数据迁移，否则用户的自动抓取会全部失败。
ECC_PRIVATE_KEY=your_p256_private_key_decimal
ECC_PUBLIC_KEY=your_p256_public_key_x_decimal

# ── RSA（请求加密）───────────────────────────────────────────
RSA_KEY_SIZE=2048
RSA_KEY_EXPIRE_MINUTES=30
# 必须保持 true。后端已强制要求加密传输，设为 false 会让
# 登录/注册/重置密码等接口全部返回 400，服务不可用。
RSA_ENABLE=true

# ── CORS（可选）──────────────────────────────────────────────
# 逗号分隔的来源白名单，例如 https://example.com,https://www.example.com
# 生产环境走 nginx 同源代理，通常留空即可。
# 留空时仅放行同源请求，不会反射任意 Origin。
ALLOWED_ORIGINS=

# ── Snowflake ────────────────────────────────────────────────
# 多实例部署时每个实例必须用不同值（0-1023），单实例保持 1
SNOWFLAKE_NODE=1

# ── 前端 / Nginx ─────────────────────────────────────────────
FRONTEND_PORT=3033
NGINX_HTTP_PORT=80
NGINX_HTTPS_PORT=443

# ── 其他 ─────────────────────────────────────────────────────
# true: 强制测试模式，验证码直接返回而不发邮件
TEST_MODE=false
