# Dependencies
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Production build
dist/
build/

# Environment files
# 裸 .env 也必须排除：Vue CLI 只注入 VUE_APP_ 前缀的变量（当前没有），
# 所以它不会进 JS 产物，但 COPY . . 会把它带进构建阶段层。
# 最终镜像只 COPY dist，中间层虽被丢弃，构建缓存里仍可读到。
.env
.env.*
!.env.example

# IDE
.vscode/
.idea/
*.swp
*.swo

# OS
.DS_Store
Thumbs.db

# Logs
*.log

# Coverage
coverage/

# Testing
.nyc_output

# Temporary files
*.tmp
*.temp