# BUCT课程提醒系统 - Go后端

## 环境配置
SECRET_KEY=your_jwt_secret_key_here
MONGO_URI=mongodb://localhost:27017/buct-course
PORT=5000

## 邮件配置
MAIL_SMTP_SERVER=smtp.163.com
MAIL_SMTP_PORT=465
MAIL_SENDER=buct_course_remind@163.com
MAIL_PASSWORD=your_email_password

## 验证码配置
CAPTCHA_EXPIRE_TIME=300
VERIFY_CODE_EXPIRE=180

## CORS配置
CORS_ALLOWED_ORIGINS=http://localhost:8080
CORS_REFRESH_INTERVAL_HOURS=6

## ECC加密密钥（可选，用于密码加密存储）
# ECC_PRIVATE_KEY=your_private_key_decimal
# ECC_PUBLIC_KEY=your_public_key_decimal

## RSA密钥（可选，用于前端数据加密传输）
# RSA_PRIVATE_KEY=your_rsa_private_key_pem
