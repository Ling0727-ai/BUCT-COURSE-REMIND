# Stage 1: Build frontend
FROM node:20-alpine as frontend_builder
WORKDIR /frontend
# Copy package.json and package-lock.json
COPY ./fronted/package*.json ./
# Install dependencies
RUN npm config set registry https://registry.npmmirror.com && npm install
# Copy frontend source code
COPY ./fronted/. .
# Build the application
RUN npm run build

# Stage 2: Setup Nginx
FROM nginx:alpine

# Copy nginx configuration from the root of the build context
COPY nginx.conf /etc/nginx/nginx.conf

# Copy built frontend files from the builder stage
COPY --from=frontend_builder /frontend/dist /usr/share/nginx/html

# Create SSL directory (optional)
RUN mkdir -p /etc/nginx/ssl

# Expose ports
EXPOSE 80
EXPOSE 443

# Start Nginx
CMD ["nginx", "-g", "daemon off;"]